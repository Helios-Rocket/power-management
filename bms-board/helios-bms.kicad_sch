	)
	(text "5ms rise time (to 12V): SR = 12V/5ms = 2.4V/ms\nEq. 10: 3300/(2.4 V/ms) = 1375pF ~ 1500pF -> 2.2V/ms\n2.2V/ms = 5.5ms\n"
		(exclude_from_sim no)
		(at 57.15 117.094 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify right top)
		)
		(uuid "83cd90ff-6c76-40e6-8dfa-d4bcf1698df9")
	)
	(text "Battery Cell\nVoltage Monitoring"
		(exclude_from_sim no)
		(at 230.632 128.778 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "981cb116-f30d-4d78-9cd3-2ea0f648b4f9")
	)
	(text "Assume 0.5A load @ 6V for 6ms: (switching time)\nF = (0.5A * 15ms)/6V = 500uF ~ 470uF\nGets better with less current or higher voltage\n\nInrush(mA) = 470uF * 2.2V/ms = 1.034A\nPDinrush(W) = 0.5 * 12V * 1.034A = 6.204W\nThat dissipated power is tolerable for ~100ms,\nmuch more than the ~6ms of inrush time expected"
		(exclude_from_sim no)
		(at 93.218 98.298 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "a1f1ce6e-9d78-47ea-86f7-590d482a376e")
	)
