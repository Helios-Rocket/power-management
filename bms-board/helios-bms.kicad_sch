	(text "4.8V PGTH\nEq. 13: 4.8V = 1.2V (Rtop + Rbot)/Rbot \n-> 4 = Rtop+Rbot/Rbot\nRtop = 150k, Rbot = 50k\n4.8V/(Rtop + Rbot) = 24uA\n>20x than PGTH leakage current\n49.9k for sourcing reasons"
		(exclude_from_sim no)
		(at 74.93 109.982 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "2dddc525-3750-44b7-9b93-cc4d1e9dad9f")
	)
	(text "OVLO ~ 13.2V (ground power)\nUVLO ~ 4.6V (2.3V/cell)\nValues are close enough. \n"
		(exclude_from_sim no)
		(at 36.322 113.284 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify right bottom)
		)
		(uuid "34422879-bf73-4f4f-80bc-6fa4ce88e7d6")
	)
	(text "DS 10.2.2\n\"Typical Application\nwith External Power Path\""
		(exclude_from_sim no)
		(at 142.24 15.24 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify right top)
		)
		(uuid "35027c36-a823-4fef-83ba-7916ea5a74b3")
	)
	(text "Sets charge cutoff.\nVREG = 1.1 * (1 + RFBT/RFBB)\nVREG = 7.2V = 3.6V * 2 (2S LiFePO4)\nRFBT = 1.1M\nRFBB = 200k"
		(exclude_from_sim no)
		(at 161.29 59.69 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "3a29ce20-5627-4440-b480-7954e4a838e3")
	)
	(text "RFBT = 36k\nRFBB = 10k\n= 3.707V output\nL1 = 3.3uH (reused from 3.3V setpoint in DS)\nCout = 44uF (reused from 3.3V/5V setpoint in DS)\nCFF = 22pF (midrange of recommended values from 3.3V/5V setpoint in DS)"
		(exclude_from_sim no)
		(at 13.97 80.01 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "3c4cd2ca-6ef3-4d82-834b-530b82e2cbc2")
	)
	(text "Close enough\nto reference design value.\nShould give 0.5V for ~5.2A.\n"
		(exclude_from_sim no)
		(at 62.484 118.618 0)
		(effects
			(font
				(size 0.889 0.889)
