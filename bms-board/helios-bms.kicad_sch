	)
	(text "Assume 0.5A load @ 6V for 6ms: (switching time)\nF = (0.5A * 15ms)/6V = 500uF ~ 470uF\nGets better with less current or higher voltage\n\nInrush(mA) = 470uF * 2.2V/ms = 1.034A\nPDinrush(W) = 0.5 * 12V * 1.034A = 6.204W\nThat dissipated power is tolerable for ~100ms,\nmuch more than the ~6ms of inrush time expected"
		(exclude_from_sim no)
		(at 95.758 137.668 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "a1f1ce6e-9d78-47ea-86f7-590d482a376e")
	)
