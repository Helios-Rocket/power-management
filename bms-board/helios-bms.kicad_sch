		)
		(uuid "3e7c4406-0b68-4fed-8d9f-c0584828d5c4")
	)
	(text "Sets charge current.\nICHG = KCHG * R\nFrom Figure 8-7\nKCHG(@ICHG=0.25A)= ~40800 A*Ohm\n40800 A*Ohm / 160kOhm = 0.255A"
		(exclude_from_sim no)
		(at 120.65 62.484 0)
